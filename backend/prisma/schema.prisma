generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
}

enum ItemType {
  FLAT
  SIZE_STYLE_MATRIX
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionScope {
  ORDER
  CATEGORY
  ITEM
}

model Location {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  waNumber    String
  timezone    String   @default("America/Mexico_City")
  currency    String   @default("MXN")
  active      Boolean  @default(true)
  addressText String?
  // Short line under the name in the customer site's header, e.g. "Pizza de
  // horno, hecha en Maltrata." Null renders no tagline at all rather than a
  // guessed default -- most of this feature's other hardcoded pizzeria copy
  // (name, address, phone) had an obvious per-tenant replacement; this one
  // didn't, so it stays optional (docs/multi-tenant-branding-plan.md).
  tagline     String?
  // Free-text footer notices, e.g. an age-restriction line for a tenant that
  // sells alcohol. Null shows nothing -- unlike name/logo/address, most
  // tenants won't need one at all, so there is no sensible non-null default
  // for a brand-new location (docs/multi-tenant-branding-plan.md).
  legalNotice String?
  // Same reasoning as legalNotice: an optional footer note, e.g. "some prices
  // are still being confirmed." Chesa're's seeded value is today's exact
  // "still transcribing the printed menu" text -- genuinely true for this
  // tenant right now, not permanent boilerplate every future tenant inherits.
  demoNotice  String?
  // Validated server-side against SUPPORTED_COLOR_SCHEMES (backend/src/schemas/
  // locations.ts) -- a free string here, not an enum, so adding or renaming a
  // scheme never needs a migration.
  colorScheme String   @default("rojo-clasico")
  logoAssetId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logoAsset     LocationAsset?  @relation("LocationLogo", fields: [logoAssetId], references: [id])
  assets        LocationAsset[] @relation("LocationAssetOwner")
  businessHours BusinessHours[]
  adminUsers    AdminUser[]
  categories    MenuCategory[]
  promotions    Promotion[]
  customers     Customer[]
  orders        Order[]
}

// One row per upload, never mutated in place -- a new logo creates a new row
// and repoints Location.logoAssetId, so a given id's bytes never change and
// the public serving route can cache them forever (see docs/
// multi-tenant-branding-plan.md). Orphaned rows (no Location pointing at them
// any more) are left alone; that cleanup isn't worth it yet.
model LocationAsset {
  id         String   @id @default(cuid())
  locationId String
  mimeType   String
  data       Bytes
  size       Int
  createdAt  DateTime @default(now())

  location     Location  @relation("LocationAssetOwner", fields: [locationId], references: [id], onDelete: Cascade)
  logoFor      Location? @relation("LocationLogo")

  @@index([locationId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  locationId String
  dayOfWeek  Int
  opensAt    Int?
  closesAt   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model AdminUser {
  id                  String    @id @default(cuid())
  locationId          String?
  email               String    @unique
  name                String
  passwordHash        String
  role                AdminRole @default(STAFF)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  location Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sessions AdminSession[]

  @@index([locationId])
}

model AdminSession {
  id          String   @id
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  userAgent   String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model MenuCategory {
  id          String   @id @default(cuid())
  locationId  String
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  // One of CATEGORY_ICON_KEYS (backend/src/schemas/menu.ts) -- the built-in,
  // cuisine-agnostic default shown until/unless the tenant uploads their own
  // (iconAssetId below). Null falls back to a generic icon, never a guess.
  iconKey     String?
  iconAssetId String?  @unique
  // "gallery" | "rows" | null. Controls which card component the storefront
  // uses for this category's items -- gallery is the big, image-forward
  // vertical card (customer/src/components/MenuSections.tsx's `Card`), rows
  // is the compact horizontal one (`CardRow`), used everywhere else today.
  // Null means "rows", except the seeded "pizzas" category, which is seeded
  // as "gallery" to preserve its exact current look. This used to be decided
  // by a hardcoded `category.slug === "pizzas"` check in that same file --
  // real data now, not a string match on this pizzeria's own slug, so any
  // tenant's own simple, photogenic items (tacos, sandwiches, whatever) can
  // get the same treatment.
  displayStyle String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location     Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  iconAsset    CategoryIcon?             @relation("CategoryIconChosen", fields: [iconAssetId], references: [id])
  icons        CategoryIcon[]            @relation("CategoryIconOwner")
  sizeOptions  MenuCategorySizeOption[]
  styleOptions MenuCategoryStyleOption[]
  items        MenuItem[]
  promotions   Promotion[]

  @@unique([locationId, slug])
  @@index([locationId])
}

// Same content-addressed pattern as LocationAsset (docs/multi-tenant-branding-plan.md):
// a new upload always creates a new row and repoints MenuCategory.iconAssetId
// rather than mutating bytes in place, which is what makes the immutable cache
// header on the serving route safe. Orphaned rows are left alone.
model CategoryIcon {
  id         String   @id @default(cuid())
  categoryId String
  mimeType   String
  data       Bytes
  size       Int
  createdAt  DateTime @default(now())

  category  MenuCategory  @relation("CategoryIconOwner", fields: [categoryId], references: [id], onDelete: Cascade)
  iconFor   MenuCategory? @relation("CategoryIconChosen")

  @@index([categoryId])
}

// Same content-addressed pattern as CategoryIcon/LocationAsset -- a new upload
// creates a new row and repoints MenuItem.imageAssetId rather than mutating
// bytes in place.
model MenuItemImage {
  id         String   @id @default(cuid())
  itemId     String
  mimeType   String
  data       Bytes
  size       Int
  createdAt  DateTime @default(now())

  item    MenuItem  @relation("MenuItemImageOwner", fields: [itemId], references: [id], onDelete: Cascade)
  imageOf MenuItem? @relation("MenuItemImageChosen")

  @@index([itemId])
}

model MenuCategorySizeOption {
  id         String   @id @default(cuid())
  categoryId String
  slug       String
  name       String
  comment    String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   MenuCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceCells MenuItemPriceCell[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model MenuCategoryStyleOption {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   MenuCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceCells MenuItemPriceCell[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model MenuItem {
  id            String   @id @default(cuid())
  categoryId    String
  slug          String
  name          String
  description   String?
  itemType      ItemType @default(FLAT)
  flatPrice     Decimal? @db.Decimal(10, 2)
  // Cosmetic sub-heading within a category's flat-item list, e.g. "Frappés" /
  // "Cafés y tés" inside one "Frappés y café" category. Null means the item
  // renders in its category's undifferentiated list.
  subgroupLabel String?
  // Overrides the category's own iconKey for this one item -- e.g. a coffee
  // item inside an otherwise frappé-iconed category. One of CATEGORY_ICON_KEYS
  // (backend/src/schemas/menu.ts), or null to just use the category's default.
  iconKey       String?
  // A real photo of the dish, if the tenant has one -- takes priority over
  // everything else in itemIcon() (the category's own uploaded image, iconKey,
  // and the built-in icon set), since a real photo beats any symbolic icon.
  // Same content-addressed pattern as LocationAsset/CategoryIcon: a new
  // upload creates a new MenuItemImage row and repoints this rather than
  // mutating bytes in place.
  imageAssetId  String?  @unique
  toppingColors Json?
  isFeatured    Boolean  @default(false)
  ageRestricted Boolean  @default(false)
  available     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category     MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageAsset   MenuItemImage?        @relation("MenuItemImageChosen", fields: [imageAssetId], references: [id])
  images       MenuItemImage[]       @relation("MenuItemImageOwner")
  priceCells   MenuItemPriceCell[]
  optionGroups MenuItemOptionGroup[]
  orderItems   OrderItem[]
  promotions   Promotion[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model MenuItemPriceCell {
  id            String   @id @default(cuid())
  menuItemId    String
  sizeOptionId  String
  styleOptionId String
  price         Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menuItem    MenuItem                @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sizeOption  MenuCategorySizeOption  @relation(fields: [sizeOptionId], references: [id], onDelete: Cascade)
  styleOption MenuCategoryStyleOption @relation(fields: [styleOptionId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, sizeOptionId, styleOptionId])
  @@index([menuItemId])
}

model MenuItemOptionGroup {
  id            String        @id @default(cuid())
  menuItemId    String
  name          String
  selectionType SelectionType @default(SINGLE)
  required      Boolean       @default(true)
  minSelections Int           @default(1)
  maxSelections Int           @default(1)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  menuItem MenuItem               @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  choices  MenuItemOptionChoice[]

  @@index([menuItemId])
}

model MenuItemOptionChoice {
  id            String   @id @default(cuid())
  optionGroupId String
  name          String
  priceDelta    Decimal  @default(0) @db.Decimal(10, 2)
  priceOverride Decimal? @db.Decimal(10, 2)
  available     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  optionGroup MenuItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
}

model Promotion {
  id            String         @id @default(cuid())
  locationId    String
  name          String
  description   String?
  code          String?
  discountType  DiscountType
  discountValue Decimal        @db.Decimal(10, 2)
  scope         PromotionScope @default(ORDER)
  categoryId    String?
  menuItemId    String?
  minSubtotal   Decimal?       @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  menuItem MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@unique([locationId, code])
  @@index([locationId])
}

model Customer {
  id          String    @id @default(cuid())
  locationId  String
  phone       String
  name        String?
  addressText String?
  notes       String?
  orderCount  Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([locationId, phone])
  @@index([locationId])
}

model Order {
  id String @id @default(cuid())

  // Short human-readable sequence the customer is given on the confirmation screen
  // and staff read back on the phone. A Postgres sequence, not a per-location
  // counter, so two simultaneous orders can never collide on it.
  orderNumber Int @unique @default(autoincrement())

  locationId      String
  customerId      String?
  fulfillmentType FulfillmentType @default(PICKUP)
  status          OrderStatus     @default(PENDING)
  customerName    String?
  // Required: with WhatsApp out of the order path this is the only way staff can
  // reach a customer about their order.
  customerPhone   String
  customerAddress String?
  customerNote    String?
  subtotal        Decimal         @db.Decimal(12, 2)
  discountTotal   Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  promotionId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  location  Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items     OrderItem[]

  @@index([locationId, createdAt])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  menuItemId     String?
  nameSnapshot   String
  sizeSnapshot   String?
  styleSnapshot  String?
  optionSnapshot String?
  notes          String?
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}
