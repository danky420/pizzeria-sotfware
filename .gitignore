# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
# dist/ at any depth: backend/dist, customer/dist, admin/dist, employee/dist.
# All regenerated by `npm run build`, so none of it gets committed.
dist/

# ---------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------
# This project HAS runtime secrets: DATABASE_URL and SESSION_COOKIE_SECRET
# in .env, plus per-app .env.local files. See READER.md, "Handling secrets".
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
.netrc
.git-credentials
id_rsa
id_ed25519
*.pub
credentials.json
secrets.json
secrets.yml
.netlify/
.vercel/
.wrangler/

# ---------------------------------------------------------------
# Python (retired scripts in scripts/archive/)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Node — backend/ (Fastify + Prisma) and admin/ (SPA)
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# Compiled output. The bare `dist/` rule at the top of this file already
# covers backend/dist and admin/dist at any depth; these cover the rest.
build/
*.tsbuildinfo

# Test and dev-server caches
coverage/
.vite/
.vitest/

# Prisma generates its client into node_modules/.prisma (already ignored).
# This catches a custom `output` target if one is ever configured.
backend/src/generated/

# ---------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------
# Browser binaries are ~150 MB and get installed, never committed.
ms-playwright/
playwright-report/
test-results/

# ---------------------------------------------------------------
# Scratch space
# ---------------------------------------------------------------
# Deliberately NOT ignoring *.png / *.jpg / *.webp — assets/source/ holds
# the real menu photographs and they are source. Put throwaway crops,
# experiments and screenshots in one of these instead.
scratch/
tmp/
*.tmp

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.\#*
\#*\#

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
