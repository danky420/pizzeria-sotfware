# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
# dist/ is regenerated by `python build.py`. Everything in it is derived
# from src/ + assets/source/, so it never gets committed.
dist/

# ---------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------
# This project has no runtime secrets today (no backend, no API keys).
# These rules exist so that stays true by accident as well as by design.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
.netrc
.git-credentials
id_rsa
id_ed25519
*.pub
credentials.json
secrets.json
secrets.yml
.netlify/
.vercel/
.wrangler/

# ---------------------------------------------------------------
# Python (build.py, scripts/)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Node — not used yet, here in case tooling gets added later
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# ---------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------
# Browser binaries are ~150 MB and get installed, never committed.
ms-playwright/
playwright-report/
test-results/

# ---------------------------------------------------------------
# Scratch space
# ---------------------------------------------------------------
# Deliberately NOT ignoring *.png / *.jpg / *.webp — assets/source/ holds
# the real menu photographs and they are source. Put throwaway crops,
# experiments and screenshots in one of these instead.
scratch/
tmp/
*.tmp

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.\#*
\#*\#

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
