# This project has no runtime secrets — the site is a single static HTML
# file with no backend, no API keys and no database.
#
# This file exists so that if that ever changes, the convention is already
# in place: copy to .env, fill in real values, and never commit .env.
#
# Example of what might land here later:
# ANALYTICS_SITE_ID=
# NETLIFY_AUTH_TOKEN=


# ===============================================================
# backend/ — Fastify API + Postgres (added with the admin backend)
# ===============================================================
# The note above describes the original static-only site, which is still
# how the customer page ships. Everything below belongs to backend/ only.
# Copy this file to .env at the repo root, fill in real values, run the
# server from backend/. Never commit the filled-in .env.

# Postgres connection string used by Prisma (migrations and runtime).
DATABASE_URL=postgresql://pizzeria:pizzeria@localhost:5432/pizzeria?schema=public

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every signed cookie and logs all admins out.
SESSION_COOKIE_SECRET=

# Origin the admin SPA is served from. Single value, no trailing slash.
# Used for CORS and for the session cookie, so it must match exactly.
ADMIN_ORIGIN=http://localhost:5173

# Origins allowed to call /api/public (the customer ordering page).
# Comma-separated, no trailing slashes, no spaces.
PUBLIC_SITE_ORIGINS=http://localhost:8000

# Port the API listens on.
PORT=3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
