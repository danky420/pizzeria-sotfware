# ===============================================================
# backend/ — Fastify API + Postgres
# ===============================================================
# Copy this file to .env at the repo root, fill in real values, and never
# commit the filled-in .env. backend/.env is read first if it exists.
#
# These are real secrets. The project's earlier "there are no runtime
# secrets" position belonged to the retired single-file static site
# (src/archive/chesare-v2-vanilla-js.html) and no longer applies — see
# READER.md, "Handling secrets".
#
# Frontend config is separate: admin/, employee/ and customer/ each read
# their own .env.local. Anything named VITE_* is compiled into the browser
# bundle and is PUBLIC — never put a secret there.
# See employee/.env.example for the documented frontend shape.

# Postgres connection string used by Prisma (migrations and runtime).
DATABASE_URL=postgresql://pizzeria:pizzeria@localhost:5432/pizzeria?schema=public

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every signed cookie and logs all admins out.
SESSION_COOKIE_SECRET=

# Origin the admin SPA is served from. Single value, no trailing slash.
# Used for CORS and for the session cookie, so it must match exactly.
ADMIN_ORIGIN=http://localhost:5173

# Origins allowed to call /api/public (the customer ordering page).
# Comma-separated, no trailing slashes, no spaces.
PUBLIC_SITE_ORIGINS=http://localhost:8000

# Port the API listens on.
PORT=3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
